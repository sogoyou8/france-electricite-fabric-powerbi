table fact_energie
	lineageTag: 34304a75-0c26-4cd1-a630-a43208407765

	measure 'Consommation totale (TWh)' =

			SUM(fact_energie[consommation_mwh]) / 1000000
		lineageTag: 74a7db43-5923-4057-a1f9-d469c289c1dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production nucléaire (TWh)' =

			SUM(fact_energie[nucleaire_mwh]) / 1000000
		lineageTag: ab9a54a4-272f-4157-945b-e845dbed6974

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production renouvelable (TWh)' =

			(
			    SUM(fact_energie[eolien_mwh])
			    + SUM(fact_energie[solaire_mwh])
			    + SUM(fact_energie[hydraulique_mwh])
			    + SUM(fact_energie[bioenergies_mwh])
			) / 1000000
		lineageTag: 12ebee6b-8f5d-48ac-9e57-0f93e56f46fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Part renouvelables (%)' =

			VAR ProductionTotale =
			    [Production nucléaire (TWh)]
			    + [Production renouvelable (TWh)]
			    + SUM(fact_energie[thermique_mwh]) / 1000000
			RETURN
			    DIVIDE(
			        [Production renouvelable (TWh)],
			        ProductionTotale
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 4890be96-5f14-40be-865e-0d452540db6b

