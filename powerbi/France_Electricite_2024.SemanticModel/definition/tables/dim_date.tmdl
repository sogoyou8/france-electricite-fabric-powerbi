table dim_date
	lineageTag: ce440a0a-c8d4-4e61-9cfc-b72dce358b54

	measure 'Production totale (TWh)' =

			DIVIDE(
			    SUM(fact_energie[nucleaire_mwh])
			    + SUM(fact_energie[eolien_mwh])
			    + SUM(fact_energie[solaire_mwh])
			    + SUM(fact_energie[hydraulique_mwh])
			    + SUM(fact_energie[bioenergies_mwh])
			    + SUM(fact_energie[thermique_mwh]),
			    1000000
			)
		lineageTag: 493349e8-781c-4731-ac77-96929b860ee1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Taux de couverture (%)' = ```

			DIVIDE(
			    [Production totale (TWh)],
			    [Consommation totale (TWh)]
			)

			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 9bdf92d5-63e8-456c-a25e-4bdbb97b4057

	measure 'Production éolienne (TWh)' = ```

			DIVIDE(
			    SUM(fact_energie[eolien_mwh]),
			    1000000
			)

			```
		lineageTag: ad390535-fc01-4370-b28a-3b0849251788

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production solaire (TWh)' = ```

			DIVIDE(
			    SUM(fact_energie[solaire_mwh]),
			    1000000
			)

			```
		lineageTag: 6ec53aab-3195-4d79-98f9-8c8c099c88a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production hydraulique (TWh)' = ```

			DIVIDE(
			    SUM(fact_energie[hydraulique_mwh]),
			    1000000
			)

			```
		lineageTag: cf84246b-5059-4791-82e9-b65a4dd342a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Production bioénergies (TWh)' = ```

			DIVIDE(
			    SUM(fact_energie[bioenergies_mwh]),
			    1000000
			)

			```
		lineageTag: 61fc8a1f-2c76-4dd9-b7d6-2e33b7ee7df8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Écart contrôle renouvelables (TWh)' = ```

			[Production renouvelable (TWh)]
			- (
			    [Production hydraulique (TWh)]
			    + [Production éolienne (TWh)]
			    + [Production solaire (TWh)]
			    + [Production bioénergies (TWh)]
			)

			```
		formatString: 0.0000
		lineageTag: 00728ee8-7ca7-417f-a10b-6d04cdb0baed


	measure 'Production thermique (TWh)' = ```

			DIVIDE(
			    SUM(fact_energie[thermique_mwh]),
			    1000000
			)

			```
		lineageTag: aa7d3e6a-ca9c-4c01-8ac6-74bee6404e78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

